# Copy this file to .env and fill in real values. Never commit .env.

# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')|console.log"
JWT_SECRET=replace-with-64-byte-random-hex
JWT_REFRESH_SECRET=replace-with-different-64-byte-random-hex

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SQLite for local dev. Railway will set this automatically when you add a Postgres DB addon.
# Local:      DATABASE_URL="file:./dev.db"
# Railway:    DATABASE_URL is set automatically — just add the Postgres addon in Railway dashboard
DATABASE_URL="file:./dev.db"

PORT=3001

# Comma-separated list of allowed frontend origins (no trailing slash)
# Example for production: https://cookforme.com,https://www.cookforme.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# Optional: comma-separated emails that should be created as ADMIN on signup
# Example: ADMIN_EMAILS=owner@cookformeapp.com
ADMIN_EMAILS=
